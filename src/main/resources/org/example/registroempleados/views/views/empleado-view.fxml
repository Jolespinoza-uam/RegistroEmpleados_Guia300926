<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox spacing="12.0" styleClass="ventana" stylesheets="@estilos/estilos.css"  xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.registroempleados.controller.EmpleadoController">
    <padding>
        <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
    </padding>

    <Label styleClass="titulo" text="Registro Empleados">
      <font>
         <Font name="System Bold" size="18.0" />
      </font></Label>

    <GridPane hgap="14.0" vgap="10.0">
        <columnConstraints>
            <ColumnConstraints minWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints minWidth="110.0" />
            <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>

        <Label text="Nombres:" GridPane.rowIndex="0" />
        <TextField fx:id="txtNombres" GridPane.columnIndex="1" GridPane.rowIndex="0" />
        <Label text="Apellidos:" GridPane.columnIndex="2" GridPane.rowIndex="0" />
        <TextField fx:id="txtApellidos" GridPane.columnIndex="3" GridPane.rowIndex="0" />

        <Label text="Cédula:" GridPane.rowIndex="1" />
        <TextField fx:id="txtCedula" GridPane.columnIndex="1" GridPane.rowIndex="1" />
        <Label text="Correo:" GridPane.columnIndex="2" GridPane.rowIndex="1" />
        <TextField fx:id="txtCorreo" GridPane.columnIndex="3" GridPane.rowIndex="1" />

        <Label text="Teléfono:" GridPane.rowIndex="2" />
        <TextField fx:id="txtTelefono" GridPane.columnIndex="1" GridPane.rowIndex="2" />
        <Label text="Cargo:" GridPane.columnIndex="2" GridPane.rowIndex="2" />
        <TextField fx:id="txtCargo" GridPane.columnIndex="3" GridPane.rowIndex="2" />

        <Label text="Departamento:" GridPane.rowIndex="3" />
        <ComboBox fx:id="cmbDepartamento" maxWidth="Infinity" promptText="Seleccione..." GridPane.columnIndex="1" GridPane.rowIndex="3" />
        <Label text="Salario:" GridPane.columnIndex="2" GridPane.rowIndex="3" />
        <TextField fx:id="txtSalario" GridPane.columnIndex="3" GridPane.rowIndex="3" />

        <Label text="Fecha contratación:" GridPane.rowIndex="4" />
        <DatePicker fx:id="dpFechaContratacion" maxWidth="Infinity" GridPane.columnIndex="1" GridPane.rowIndex="4" />
        <Label text="Estado:" GridPane.columnIndex="2" GridPane.rowIndex="4" />
        <ComboBox fx:id="cmbEstado" maxWidth="Infinity" promptText="Seleccione..." GridPane.columnIndex="3" GridPane.rowIndex="4" />
      <rowConstraints>
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
         <RowConstraints />
      </rowConstraints>
    </GridPane>

    <HBox alignment="CENTER" spacing="12.0">
        <Button fx:id="btnGuardar" onAction="#guardarEmpleado" styleClass="boton-primario" text="Guardar" />
        <Button fx:id="btnLimpiar" onAction="#limpiarFormulario" styleClass="boton-secundario" text="Limpiar" />
        <Button fx:id="btnActualizar" onAction="#actualizarTabla" styleClass="boton-secundario" text="Actualizar tabla" />
    </HBox>

    <Label styleClass="subtitulo" text="Empleados registrados:">
      <font>
         <Font size="14.0" />
      </font></Label>

    <TableView fx:id="tblEmpleados" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" prefWidth="45.0" text="ID" />
            <TableColumn fx:id="colNombres" prefWidth="100.0" text="Nombres" />
            <TableColumn fx:id="colApellidos" prefWidth="110.0" text="Apellidos" />
            <TableColumn fx:id="colCedula" prefWidth="120.0" text="Cédula" />
            <TableColumn fx:id="colCorreo" prefWidth="150.0" text="Correo" />
            <TableColumn fx:id="colTelefono" prefWidth="85.0" text="Teléfono" />
            <TableColumn fx:id="colCargo" prefWidth="100.0" text="Cargo" />
            <TableColumn fx:id="colDepartamento" prefWidth="110.0" text="Departamento" />
            <TableColumn fx:id="colSalario" prefWidth="75.0" text="Salario" />
            <TableColumn fx:id="colFechaContratacion" prefWidth="100.0" text="Contratación" />
            <TableColumn fx:id="colEstado" prefWidth="70.0" text="Estado" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>
</VBox>
